msgstr "En la práctica, podemos muestrear de esta distribución mediante:"

#: ../source/notebooks/general/prior_predictive.ipynb:10119
#: e599782b04c2411f974f8d67fd583c82
#, python-brace-format
msgid "Drawing parameters from the prior: $\\theta^{(s)} \\sim p(\\theta)$"
msgstr "Extrayendo parámetros de lo anterior: $\\theta^{(s)} \\sim p(\\theta)$"

#: ../source/notebooks/general/prior_predictive.ipynb:10120
#: 1a2e4f73f6fa47209706d02dfadc0199
#, python-brace-format
msgid "Generating data from the likelihood: $y^{(s)} \\sim p(y|\\theta^{(s)})$"
msgstr ""
"Generando datos a partir de la verosimilitud: $y^{(s)} \\sim "
"p(y|\\theta^{(s)})$"

#: ../source/notebooks/general/prior_predictive.ipynb:10122
#: ac4c845491fe49c89bfa18631e50bc5d
