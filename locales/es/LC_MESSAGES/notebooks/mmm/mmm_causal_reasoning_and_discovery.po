#: 0bbb3b88bcf6483da3796e886fad8489
msgid ""
"[PC Algorithm for Tabular Causal "
"Discovery](https://opensource.salesforce.com/causalai/latest/tutorials/PC_Algorithm_Tabular.html)"
msgstr ""
"[Algoritmo PC para el Descubrimiento Causal "
"Tabular](https://opensource.salesforce.com/causalai/latest/tutorials/PC_Algorithm_Tabular.html)"

#: ../source/notebooks/mmm/mmm_causal_reasoning_and_discovery.ipynb:740055
#: 005abfff572e45bbb0ca8ca959b8fa08
