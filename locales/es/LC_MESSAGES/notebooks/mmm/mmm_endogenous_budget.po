#: 0aeef16ce35f4fcc977c811a3b73e713
msgid "Bias in a plain MMM"
msgstr "Sesgo en un MMM simple"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 9ac5a6915941433abd5b1acfe770d731
#, python-brace-format
msgid "Expected $\\gamma_{TV}$"
msgstr "$\\gamma_{TV}$ esperado"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 290968c7aa5547319145db6d734d5d4a
msgid "Target chasing"
msgstr "Persecución de metas"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 51a5cc860f684043b55ca61f8b3b68ab
msgid "Reacts to last week's sales gap against plan"
msgstr "Reacciona a la brecha de ventas de la semana pasada respecto al plan"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 68bee5aafc3442b89e370726450adc59
msgid "Understates TV"
msgstr "Subestima la TV"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 9fd432a7727d403aa3b0a753c982103c
