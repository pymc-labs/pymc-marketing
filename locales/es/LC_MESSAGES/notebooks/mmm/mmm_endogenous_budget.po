msgid "Follows demand only through recorded controls"
msgstr "Sigue la demanda solo a través de los controles registrados"

#: ../source/notebooks/mmm/mmm_endogenous_budget.ipynb:510006
#: 73d7ed52886047a198b7ff88ea3d1ea3
