msgid "$P-1$"
msgstr "$P-1$"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: 3390de96218a41b99c1e3a01cf346efa
msgid "a single known awareness driver"
msgstr "un único impulsor de conocimiento de marca conocido"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
