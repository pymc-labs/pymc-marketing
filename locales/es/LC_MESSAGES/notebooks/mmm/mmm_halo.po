msgid "$\\sum_f P_f(P_f-1)$"
msgstr "$\\sum_f P_f(P_f-1)$"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: 5abf78fc887a41a286c332a900282888
