msgstr "Entradas activas"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: cb105605592b43188b1d2e467046a5ed
msgid "Parameters"
msgstr "Parámetros"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: 9cc5cfe9498a40d7926f0705abacdc1a
msgid "Assumption"
msgstr "Supuesto"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: 41c3019dbd74460cbe04514e10569ff1
msgid "Flagship"
msgstr "Producto insignia"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
#: 77ed26e8dfe74de084391d24bbc5c746
msgid "one source column"
msgstr "una columna de origen"

#: ../source/notebooks/mmm/mmm_halo.ipynb:30002
