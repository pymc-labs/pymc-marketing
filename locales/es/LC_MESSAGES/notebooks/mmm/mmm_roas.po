#: ../source/notebooks/mmm/mmm_roas.ipynb:240002
#: ../source/notebooks/mmm/mmm_roas.ipynb:440002
#: 0c6de15b993842c3b41daa511fd65d48 414daa1b31314236985a185f43330cd2
msgid "\\displaystyle 0"
msgstr "\\displaystyle 0"

#: ../source/notebooks/mmm/mmm_roas.ipynb:250002
