msgid "**Combining θ and α:**"
msgstr "**Combinación de θ y α:**"

#: ../source/notebooks/mmm/adstock_functions_guide.ipynb:280039
#: 154342b4a271476bb4963b898e780bfc
msgid ""
"**High θ + Low α**: Sharp peak after delay, then rapid drop-off "
