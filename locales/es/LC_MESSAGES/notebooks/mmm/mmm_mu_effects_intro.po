msgid "Updates the data of the effect, for example for new dates."
msgstr "Actualiza los datos del efecto, por ejemplo para fechas nuevas."

#: ../source/notebooks/mmm/mmm_mu_effects_intro.ipynb:10027
#: 682e4320400b4953ac5fc4d85bbcb393
msgid "`incrementality_spec()`"
msgstr "`incrementality_spec()`"

#: ../source/notebooks/mmm/mmm_mu_effects_intro.ipynb:10027
#: 4378ec053850428195e2461d4c8debb2
msgid "In `mmm.incrementality`, and when the budget optimizer sizes its window"
msgstr ""
"En `mmm.incrementality`, y cuando el optimizador de presupuesto dimensiona "
"su ventana"

#: ../source/notebooks/mmm/mmm_mu_effects_intro.ipynb:10027
#: ac2219fbd1b443cd8cfba73eb1145d1e
msgid ""
"Lets `mmm.incrementality` include the effect when it sets the spend of a "
"channel to zero, and declares extra carryover weeks of the effect."
msgstr ""
"Permite que `mmm.incrementality` incluya el efecto cuando lleva a cero el "
"gasto de un canal, y declara las semanas de arrastre adicionales del efecto."

#: ../source/notebooks/mmm/mmm_mu_effects_intro.ipynb:10027
#: 1b6b4e3afa69404baa2ee5d9b67a3554
