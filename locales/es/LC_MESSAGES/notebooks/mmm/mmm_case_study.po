#: ../source/notebooks/mmm/mmm_case_study.ipynb:1440014
#: fea6d1554728434c9ca17dd2ac1cf2a6
msgid "**Channel-Specific Insights**:"
msgstr "**Ideas específicas por canal**:"

#: ../source/notebooks/mmm/mmm_case_study.ipynb:1440015
#: c3634e97d6f24b6092bbf67be81f6f74
msgid "**Online Display**: Highest ROAS, strong candidate for budget increases"
msgstr ""
"**Online Display**: ROAS más alto, fuerte candidato para aumentos de "
