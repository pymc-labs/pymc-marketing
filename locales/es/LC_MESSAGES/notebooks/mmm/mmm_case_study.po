#: ../source/notebooks/mmm/mmm_case_study.ipynb:1440010
#: 760acc0c9e9f476a91a3d72d78f2b578
msgid "**10% potential sales uplift** through strategic budget reallocation"
msgstr ""
"**10% de incremento potencial en las ventas** mediante una reasignación "
"estratégica del presupuesto"

#: ../source/notebooks/mmm/mmm_case_study.ipynb:1440011
#: 3d2703f5debf4e4eb268eff9624df9c6
msgid ""
"**High-ROAS channels identified**: `Online Display` and `Insert` show the"
" highest efficiency"
msgstr ""
"**Canales de ROAS alto identificados**: `Online Display` e `Insert` muestran"
" la mayor eficiencia"

#: ../source/notebooks/mmm/mmm_case_study.ipynb:1440012
#: c1b1ceabcd9e4af1b1babd21f53804c8
