#: 0c7ba0d29f334c2095014cfc8e349529
msgid "channel contributions,"
msgstr "contribuciones de los canales,"

#: ../source/notebooks/mmm/mmm_custom_splines.ipynb:260007
#: cafc99fb58bd42d487da7ed19b2f43ce
msgid "spline baseline (`time_varying_intercept`),"
msgstr "línea base de splines (`time_varying_intercept`),"

#: ../source/notebooks/mmm/mmm_custom_splines.ipynb:260008
#: d73ea3d27c1d404b9e415c53109bca2d
msgid "Fourier seasonality,"
msgstr "estacionalidad de Fourier,"

#: ../source/notebooks/mmm/mmm_custom_splines.ipynb:260009
#: fc8dc351dff6496c96f2f6f459c29643
msgid "and control effects."
msgstr "y efectos de control."

