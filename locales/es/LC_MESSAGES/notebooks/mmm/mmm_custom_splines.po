#: 07aeeb31b3bb40b28c0ff6d88e83971b
msgid "**Hierarchical geo structure** for media and controls,"
msgstr "**Estructura geo jerárquica** para medios y controles,"

#: ../source/notebooks/mmm/mmm_custom_splines.ipynb:280007
#: 6bd512d950044629a7dba14e0f8e87ef
msgid "**Spline baseline** for smooth long-run variation,"
msgstr "**Línea base de splines** para una variación suave de largo plazo,"

#: ../source/notebooks/mmm/mmm_custom_splines.ipynb:280008
#: e14215c17c1b42f0ae30ff089933ae56
msgid "**Fourier seasonality** for periodic behavior,"
msgstr "**Estacionalidad de Fourier** para el comportamiento periódico,"

