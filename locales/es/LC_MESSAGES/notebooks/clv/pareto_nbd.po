msgstr "Métodos Predictivos"

#: ../source/notebooks/clv/pareto_nbd.ipynb:430004
#: ed1d9a333f66485c8b077fa4fd41891e
msgid "The Pareto/NBD model supports a variety of predictive methods:"
msgstr "El modelo Pareto/NBD admite una variedad de métodos predictivos:"

#: ../source/notebooks/clv/pareto_nbd.ipynb:430006
#: 578a86ebd8db41a48b8f7bc182140ca8
msgid "`expected_purchases`"
msgstr "`expected_purchases`"

#: ../source/notebooks/clv/pareto_nbd.ipynb:430007
#: da3523c04581475ca4dcc0c3a4fa6e4c
msgid "`expected_probability_alive`"
msgstr "`expected_probability_alive`"

#: ../source/notebooks/clv/pareto_nbd.ipynb:430008
#: afac30404c784747bd85a6b5a8a837e9
msgid "`expected_purchases_new_customer`"
msgstr "`expected_purchases_new_customer`"

#: ../source/notebooks/clv/pareto_nbd.ipynb:430009
